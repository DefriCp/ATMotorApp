{
  "name": "bengkel-pos-app",
  "productName": "AT Motor POS",
  "version": "1.0.0",
  "description": "Sistem Kasir POS dan Stock Opname Bengkel AT Motor Tasikmalaya",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "npm run start",
    "build": "vite build",
    "dist": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.atmotor.pos",
    "productName": "AT Motor POS Tasikmalaya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "database.js",
      "src/assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AT Motor POS Tasikmalaya"
    }
  }
}
